  @@index([organizationId])
  @@index([entityType, entityId])
}

model Comment {
  id             String     @id @default(cuid())
  organizationId String
  entityType     EntityType
  entityId       String
  body           String
  userId         String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([organizationId])
  @@index([entityType, entityId])
}

model ActivityLog {
  id             String     @id @default(cuid())
  organizationId String
  entityType     EntityType
  entityId       String
  action         String
  summary        String
  metadata       Json?
  userId         String?
  createdAt      DateTime   @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Documentos
// ─────────────────────────────────────────────────────────────

model Document {
  id             String     @id @default(cuid())
  organizationId String
  entityType     EntityType
  entityId       String
  fileName       String
  fileUrl        String // enlace externo (Drive/Dropbox) o ruta de descarga interna
  storageKey     String? // si el archivo se subió al servidor: ruta relativa en disco
  documentType   String?
  description    String?
  year           Int?
  mimeType       String?
  sizeBytes      Int?
  // true = generado por el sistema (p.ej. PDF de propuesta guardado al enviar,
  // obs 14). Permite reemplazar/identificar el documento auto-guardado.
  autoGenerated  Boolean    @default(false)
  uploadedById   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  versions DocumentVersion[]

  @@index([organizationId])
  @@index([entityType, entityId])
}

model DocumentVersion {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String
  version        Int
  fileUrl        String
  uploadedById   String?
  createdAt      DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────
// Siniestros
// ─────────────────────────────────────────────────────────────

enum ClaimStatus {
  REPORTED
  AWAITING_ASSIGNMENT
  IN_ADJUSTMENT
  PAYMENT_PROCESS
  CLOSED
  VOID
}

enum ClaimEntryParty {
  COMPANIA
  CORREDOR
}

enum ClaimEntryChannel {
  TELEFONO
  EMAIL
  WEB
  CALL_CENTER
  OTRO
}

enum ClaimLossType {
  PARCIAL
  TOTAL
}

enum ClaimLogKind {
  CREATED
  STATUS_CHANGED
  COMPANY_FILED
  COMPANY_NUMBER_ASSIGNED
  LIQUIDATOR_ASSIGNED
  DOCUMENT_UPLOADED
  THIRD_PARTY_ADDED
  THIRD_PARTY_REMOVED
  UPDATED
  NOTE
}

model Claim {
  id                    String      @id @default(cuid())
  organizationId        String
  clientId              String
  policyId              String?
  policyItemId          String?
  proposalItemId        String?
  branchTypeId          String?
  claimNumber           String
  folderNumber          Int
  companyClaimNumber    String?
  liquidatorName        String?
  description           String
  status                ClaimStatus @default(REPORTED)
  substatusCode         String?
  closureOutcome        String?
  adjustmentLegalDeadline DateTime? @db.Date
  closeDeadline         DateTime?   @db.Date
  closedAt              DateTime?
  closedOnTime          Boolean?
  reopenCount           Int         @default(0)
  finalReportReceivedAt DateTime?   @db.Date
  disputeDeadline       DateTime?   @db.Date
  isDisputed            Boolean     @default(false)
  isPreventive          Boolean     @default(false)
  currency              String      @default("UF")
  estimatedAmount       Decimal?    @db.Decimal(14, 2)
  settledAmount         Decimal?    @db.Decimal(14, 2)
  assignedUserId        String?
  createdById           String?
  voidedAt              DateTime?
  voidReason            String?
  reopenedAt            DateTime?
  currentStateStartedAt DateTime    @default(now())
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Ingreso del denuncio
  entryParty       ClaimEntryParty?
  entryChannel     ClaimEntryChannel?
  reportedAt       DateTime?          @db.Date
  reportedAtBroker DateTime?
  filedAtCompanyAt DateTime?

  // Denunciante
  reporterRut       String?
  reporterFirstName String?
  reporterLastName  String?
  reporterPhone     String?
  reporterEmail     String?

  // Datos del siniestro (comunes)
  occurredAt           DateTime?      @db.Date
  occurredAtTime       String?
  mainCoverageAffected String?
  policeReportDate     DateTime?      @db.Date
  policeStation        String?
  policeReportFolio    String?
  incidentCause        String?
  incidentAddress      String?
  incidentCommune      String?
  incidentCity         String?
  incidentNarrative    String?
  lossType             ClaimLossType?
  smartDeductible      Boolean?
  hasAlcoholTest       Boolean?
  driverAtFault        Boolean?
  driverFirstName      String?
  driverLastName       String?
  driverRut            String?
  driverAge            Int?

  // Datos específicos por ramo (clave/valor según BranchFieldSchema u otros)
  data Json @default("{}")

  client        Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  policyItem    PolicyItem?          @relation(fields: [policyItemId], references: [id], onDelete: SetNull)
  proposalItem  ProposalItem?        @relation(fields: [proposalItemId], references: [id], onDelete: SetNull)
  branchType    BranchType?          @relation(fields: [branchTypeId], references: [id])
  statusHistory ClaimStatusHistory[]
  thirdParties  ClaimThirdParty[]
  logs          ClaimLog[]
  extensions    ClaimAdjustmentExtension[]

  @@unique([organizationId, claimNumber])
  @@unique([organizationId, folderNumber])
  @@index([organizationId])
  @@index([clientId])
  @@index([policyId])
}

model ClaimAdjustmentExtension {
  id               String   @id @default(cuid())
  organizationId   String
  claimId          String
  requestedOn      DateTime @db.Date
  previousDeadline DateTime @db.Date
  newDeadline      DateTime @db.Date
  reason           String
  createdById      String?
  createdAt        DateTime @default(now())

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([claimId])
}

model ClaimStatusHistory {
  id             String      @id @default(cuid())
  organizationId String
  claimId        String
  status         ClaimStatus
  note           String?
  changedById    String?
  createdAt      DateTime    @default(now())

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([claimId])
}

model ClaimThirdParty {
  id              String  @id @default(cuid())
  organizationId  String
  claimId         String
  involvesVehicle Boolean @default(true)

  // Persona
  firstName String?
  lastName  String?
  rut       String?
  phone     String?
  email     String?

  // Vehículo
  vehicleType   String?
  vehicleBrand  String?
  vehicleModel  String?
  vehicleYear   Int?
  plate         String?
  engineNumber  String?
  chassisNumber String?

  // Seguro
  hasInsurance     Boolean?
  insuranceCompany String?
  policyNumber     String?

  // Culpabilidad
  atFault Boolean?

  // Bien afectado cuando no hay vehículo
  damagedGoodsDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([claimId])
}

model ClaimLog {
  id             String       @id @default(cuid())
  organizationId String
  claimId        String
  kind           ClaimLogKind
  message        String
  metadata       Json?
  userId         String?
  createdAt      DateTime     @default(now())

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([claimId])
}

// ─────────────────────────────────────────────────────────────
// Cobranza: cuotas de pago de pólizas
// ─────────────────────────────────────────────────────────────

enum InstallmentStatus {
  PENDIENTE
  PARCIAL
  PRESUNTA
  PAGADA
  RECHAZADA
  CASTIGADA
  ANULADA
  CREDITED
}

enum PremiumMovementType {
  ISSUE
  ENDORSEMENT
  REVERSAL
}

enum CommissionReceivableStatus {
  PENDING
  VOID
  SETTLED
}

// Libro de primas. La prima vigente de la póliza es la suma de estos asientos.
model PremiumMovement {
  id                    String               @id @default(cuid())
  organizationId        String
  policyId              String
  endorsementId         String?
  seqNo                 Int
  movementType          PremiumMovementType
  issuedOn              DateTime             @db.Date
  effectiveOn           DateTime             @db.Date
  premiumAffected       Decimal              @db.Decimal(18, 4)
  premiumExempt         Decimal              @db.Decimal(18, 4)
  taxAmount             Decimal              @db.Decimal(18, 4)
  premiumNet            Decimal              @db.Decimal(18, 4)
  premiumGross          Decimal              @db.Decimal(18, 4)
  commissionAffected    Decimal              @db.Decimal(18, 4)
  commissionExempt      Decimal              @db.Decimal(18, 4)
  commissionTotal       Decimal              @db.Decimal(18, 4)
  currency              String               @default("UF")
  reversesMovementId    String?              @unique
  createdById           String?
  createdAt             DateTime             @default(now())

  policy      Policy                  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  receivable  CommissionReceivable?

  @@unique([policyId, seqNo])
  @@index([organizationId])
  @@index([policyId])
  @@index([endorsementId])
}

// Comisión esperada de la corredora, una por movimiento de prima.
model CommissionReceivable {
  id             String                      @id @default(cuid())
  organizationId String
  policyId       String
  movementId     String                      @unique
  amount         Decimal                     @db.Decimal(18, 4)
  currency       String                      @default("UF")
  status         CommissionReceivableStatus  @default(PENDING)
  createdAt      DateTime                    @default(now())

  policy      Policy                 @relation(fields: [policyId], references: [id], onDelete: Cascade)
  movement    PremiumMovement        @relation(fields: [movementId], references: [id], onDelete: Cascade)
  allocations CommissionAllocation[]

  @@index([organizationId])
  @@index([policyId])
}

// Snapshot inmutable de cada envío a la compañía. La propuesta sigue siendo
// el expediente editable; este registro no se reescribe.
model PolicySubmission {
  id             String   @id @default(cuid())
  organizationId String
  proposalId     String
  seqNo          Int
  sentAt         DateTime
  snapshot       Json
  createdById    String?
  createdAt      DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, seqNo])
  @@index([organizationId])
  @@index([proposalId])
}

// Comparación de lo pedido con lo emitido. Nunca bloquea la emisión.
model AiComparison {
  id              String   @id @default(cuid())
  organizationId  String
  proposalId      String?
  policyId        String?
  verdict         String
  blocksIssuance  Boolean  @default(false)
  summary         String?
  createdAt       DateTime @default(now())

  proposal      Proposal?       @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  policy        Policy?         @relation(fields: [policyId], references: [id], onDelete: SetNull)
  discrepancies AiDiscrepancy[]

  @@index([organizationId])
  @@index([proposalId])
  @@index([policyId])
}

model AiDiscrepancy {
  id             String  @id @default(cuid())
  organizationId String
  comparisonId   String
  field          String
  expectedValue  String?
  actualValue    String?

  comparison AiComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([comparisonId])
}

// Liquidación de la compañía y calce N:M contra la comisión esperada.
model CommissionStatement {
  id             String   @id @default(cuid())
  organizationId String
  insurerName    String?
  periodFrom     DateTime? @db.Date
  periodTo       DateTime? @db.Date
  currency       String   @default("CLP")
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())

  lines CommissionStatementLine[]

  @@index([organizationId])
}

model CommissionStatementLine {
  id             String   @id @default(cuid())
  organizationId String
  statementId    String
  policyNumber   String?
  amount         Decimal  @db.Decimal(18, 4)
  currency       String   @default("CLP")

  statement   CommissionStatement    @relation(fields: [statementId], references: [id], onDelete: Cascade)
  allocations CommissionAllocation[]

  @@index([organizationId])
  @@index([statementId])
}

model CommissionAllocation {
  id             String   @id @default(cuid())
  organizationId String
  lineId         String
  receivableId   String
  amount         Decimal  @db.Decimal(18, 4)
  createdAt      DateTime @default(now())

  line       CommissionStatementLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  receivable CommissionReceivable    @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([lineId])
  @@index([receivableId])
}

// Parámetros de la corredora. La presunción PAC/PAT nace apagada.
model OrganizationSettings {
  organizationId       String  @id
  presumedPaidEnabled  Boolean @default(false)
  mfaRequired          Boolean @default(false)
  ssoEnabled           Boolean @default(false)
}

enum QuoteRequestStatus {
  BORRADOR
  SOLICITADA
  COTIZADA
  ENVIADA_CLIENTE
  GANADA
  PERDIDA
}

// Solicitud de cotización a varias compañías. No reemplaza la cotización
// de auto: esa sigue siendo el comparador simulado de vehículos.
model QuoteRequest {
  id             String             @id @default(cuid())
  organizationId String
  clientId       String
  title          String
  status         QuoteRequestStatus @default(BORRADOR)
  currency       String             @default("UF")
  lossReason     String?
  proposalId     String?            @unique
  assignedUserId String?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  client   Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposal Proposal?    @relation(fields: [proposalId], references: [id])
  offers   QuoteOffer[]

  @@index([organizationId])
  @@index([clientId])
}

model QuoteOffer {
  id             String   @id @default(cuid())
  organizationId String
  requestId      String
  insurerName    String
  premiumNet     Decimal? @db.Decimal(18, 4)
  currency       String   @default("UF")
  notes          String?
  recommended    Boolean  @default(false)
  createdAt      DateTime @default(now())

  request QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([requestId])
}

// Cola de despacho. Nace al recepcionar y se marca enviada al despachar.
model Dispatch {
  id             String    @id @default(cuid())
  organizationId String
  proposalId     String
  policyId       String?
  status         String    @default("PENDIENTE")
  recipientEmail String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  policy   Policy?  @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([proposalId])
  @@index([status])
}

// Un pago de cuota. La cuota sigue siendo el saldo; esto es el hecho de pago.
model InstallmentPayment {
  id                  String   @id @default(cuid())
  organizationId      String
  installmentId       String
  amount              Decimal  @db.Decimal(18, 4)
  paidOn              DateTime @db.Date
  companyRegisteredOn DateTime? @db.Date
  markedOn            DateTime @db.Date
  source              String   @default("MANUAL")
  note                String?
  createdById         String?
  createdAt           DateTime @default(now())

  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([installmentId])
}

enum AiExtractionStatus {
  QUEUED
  EXTRACTED
  NEEDS_REVIEW
  ACCEPTED
  REJECTED
}

// Lectura local de un texto. No sale de la corredora.
model AiExtraction {
  id             String             @id @default(cuid())
  organizationId String
  sourceKind     String
  sourceText     String
  status         AiExtractionStatus @default(QUEUED)
  policyNumber   String?
  premiumNet     Decimal?           @db.Decimal(18, 4)
  startDate      String?
  endDate        String?
  evidence       Json?
  reviewNote     String?
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId])
}

model ImportJob {
  id             String    @id @default(cuid())
  organizationId String
  profile        String
  status         String    @default("PREVIEW")
  fileName       String?
  decisionNote   String?
  choice         String?
  createdById    String?
  appliedAt      DateTime?
  revertedAt     DateTime?
  createdAt      DateTime  @default(now())

  rows ImportJobRow[]

  @@index([organizationId])
}

model ImportJobRow {
  id                String  @id @default(cuid())
  organizationId    String
  jobId             String
  rowNo             Int
  action            String
  payload           Json
  createdEntityType String?
  createdEntityId   String?
  message           String?

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([jobId])
}

model TenantFeature {
  id             String  @id @default(cuid())
  organizationId String
  code           String
  enabled        Boolean @default(false)

  @@unique([organizationId, code])
  @@index([organizationId])
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  fingerprint    String
  command        String
  resultJson     Json?
  createdAt      DateTime @default(now())

  @@unique([organizationId, key])
  @@index([organizationId])
}

// Segundo factor del usuario. No es de una corredora.
model MfaEnrollment {
  userId        String   @id
  secretBase32  String
  enabled       Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Installment {
  id             String            @id @default(cuid())
  organizationId String
  policyId       String?
  paymentPlanId  String?
  number         Int
  amount         Decimal           @db.Decimal(14, 2)
  currency       String            @default("UF")
  dueDate        DateTime          @db.Date
  status         InstallmentStatus @default(PENDIENTE)
  paidAt         DateTime?         @db.Date
  // Cobrado cuando el estado es parcial. El resto se anula al cancelar.
  amountPaid     Decimal?          @db.Decimal(14, 2)
  creditedAmount Decimal?          @db.Decimal(18, 4)
  // La cuota se anuló por la cascada de cancelación o anulación.
  voidedByTermination Boolean      @default(false)
  // Estado previo a esa anulación, para reabrirlo al borrar el endoso.
  statusBeforeTermination InstallmentStatus?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  policy   Policy?              @relation(fields: [policyId], references: [id], onDelete: Cascade)
  payments InstallmentPayment[]

  @@index([organizationId])
  @@index([policyId])
  @@index([paymentPlanId])
}

// ─────────────────────────────────────────────────────────────
// Cotizaciones de automóvil
// ─────────────────────────────────────────────────────────────

enum CarQuotationStatus {
  BORRADOR
  EN_PROCESO
  COMPLETADA
  ERROR
}

enum CarQuotationResultStatus {
  PENDIENTE
  EN_PROCESO
  OBTENIDA
  ERROR
}

enum VehicleCondition {
  NUEVO
  USADO
}

enum VehicleUse {
  PARTICULAR
  COMERCIAL
}

enum CivilLiability {
  UF_500
  UF_1000
  UF_1500
  UF_2000
}

enum WorkshopType {
  EXCLUSIVIDAD
  MARCA
}

model CarQuotation {
  id                  String             @id @default(cuid())
  organizationId      String
  clientId            String
  quotationNumber     String
  status              CarQuotationStatus @default(BORRADOR)
  patente             String
  marca               String?
  modelo              String?
  anio                Int?
  tipoVehiculo        String?
  motorizacion        String?
  vehicleCondition    VehicleCondition   @default(USADO)
  vehicleUse          VehicleUse         @default(PARTICULAR)
  civilLiability      CivilLiability     @default(UF_500)
  workshopType        WorkshopType       @default(EXCLUSIVIDAD)
  deductibles         Json
  assignedUserId      String?
  createdById         String?
  previousQuotationId String?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  client  Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  results CarQuotationResult[]

  @@unique([organizationId, quotationNumber])
  @@index([organizationId])
  @@index([clientId])
  @@index([previousQuotationId])
}

model CarQuotationResult {
  id             String                   @id @default(cuid())
  organizationId String
  quotationId    String
  insurerKey     String
  insurerName    String
  status         CarQuotationResultStatus @default(PENDIENTE)
  premiumUf      Decimal?                 @db.Decimal(14, 2)
  deductibleUf   Decimal?                 @db.Decimal(14, 2)
  planName       String?
  coverageDetail Json?
  rawData        Json?
  pdfBytes       Bytes?
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  quotation CarQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, insurerKey])
  @@index([organizationId])
  @@index([quotationId])
  @@index([status])
}

model InsurerPortalCredential {
  id                String   @id @default(cuid())
  organizationId    String
  insurerKey        String
  insurerName       String
  username          String
  passwordEncrypted String
  passwordIv        String
  passwordTag       String
  status            String   @default("ACTIVA")
  notes             String?
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([organizationId, insurerKey])
  @@index([organizationId])
}
