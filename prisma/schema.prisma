enum EndorsementType {
  AGREGA_ITEMS
  ELIMINA_ITEMS
  ANULACION_ENDOSO
  ANULACION_COMPANIA
  CAMBIO_ASEGURADO_POLIZA
  CAMBIO_ASEGURADO_ITEM
  CANCELACION_COMPANIA
  CANCELACION_NO_PAGO
  CORTE_PERDIDA_TOTAL
  ENDOSO_INTERNO
  MODIFICACION_GLOSA_ITEM
  MODIFICA_MONTO_PRIMA
  MODIFICACION
  PRORROGA
  SOLICITUD_ANULACION
  SOLICITUD_CANCELACION
}

model Endorsement {
  id                String          @id @default(cuid())
  organizationId    String
  policyId          String
  type              EndorsementType
  effectiveDate     DateTime        @db.Date
  // Fin de vigencia del endoso (por defecto, fin de la póliza).
  endDate           DateTime?       @db.Date
  // N° de endoso emitido por la compañía.
  endorsementNumber String?
  // Detalle del endoso (texto de la solicitud enviada a la compañía).
  detail            String?
  // Motivo: ya no se pide en el formulario; se conserva para endosos antiguos.
  reason            String?
  notes             String?
  // Propuesta de endoso que originó este endoso (null = registro directo).
  proposalId        String?         @unique
  // Delta de prima neta afecta y exenta. Vacío en cancelación y anulación,
  // porque ese crédito lo calcula el cierre del plan.
  premiumAffectedDelta Decimal?      @db.Decimal(18, 4)
  premiumExemptDelta   Decimal?      @db.Decimal(18, 4)
  specType             String?
  calcMethod           String?
  initiatedBy          String?
  inalterabilityNote   String?
  createdById       String?
  createdAt         DateTime        @default(now())

  policy   Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  proposal Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([policyId])
}

model ProposalStatusHistory {
  id             String         @id @default(cuid())
  organizationId String
  proposalId     String
  status         ProposalStatus
  note           String?
  returnReasonId String?
  changedById    String?
  createdAt      DateTime       @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([proposalId])
}

model ProposalReturnReason {
