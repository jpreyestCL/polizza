// Polizza — esquema de datos MVP 1
// Multi-tenant: las tablas de dominio llevan organizationId (scoping por aplicación).
// Tablas globales (Currency, ExchangeRate, Holiday) y de Better Auth no se filtran.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Better Auth — autenticación, organizaciones y membresías
// ─────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  isSuperadmin  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Organization {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String?  @unique
  logo                  String?
  metadata              String?
  // Configuración de propuestas (Polizza)
  reservaDays           Int      @default(15)
  proposalNumberPattern String   @default("{YEAR}-{SEQ:0000}")
  proposalSequenceYear  Int?
  proposalSequenceValue Int      @default(0)
  // Zona horaria IANA usada para formatear fechas/horas en UI y bitácoras.
  timezone              String   @default("America/Santiago")
  createdAt             DateTime @default(now())

  members     Member[]
  invitations Invitation[]
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("ejecutivo")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  inviterId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────
// Catálogos globales (Chile)
// ─────────────────────────────────────────────────────────────

model Currency {
  code      String   @id // UF, CLP, USD, EUR
  name      String
  symbol    String?
  createdAt DateTime @default(now())
}

model ExchangeRate {
  id           String   @id @default(cuid())
  currencyCode String
  date         DateTime @db.Date
  valueClp     Decimal  @db.Decimal(14, 4)
  createdAt    DateTime @default(now())

  @@unique([currencyCode, date])
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now())

  @@unique([date])
}

// Maestros globales de vehículos (marca, modelo, tipo). Se usan en las
// fichas de ramo "Vehículos Motorizados", "SOAP", "Equipo Móvil
// Individualizado" y "Equipo Móvil General" como autocompletes. El
// usuario puede escribir un valor libre si no está en el maestro.
model VehicleBrand {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models VehicleModel[]
}

model VehicleModel {
  id        String   @id @default(cuid())
  brandId   String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand VehicleBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, name])
  @@index([name])
}

model VehicleType {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Maestro global de comunas de Chile (datos de referencia, sin tenant).
// Código oficial INE/SUBDERE (p. ej. "13101" para Santiago).
model Commune {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  city      String // provincia / ciudad asociada
  region    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([name])
}

// ─────────────────────────────────────────────────────────────
// Maestros por organización
// ─────────────────────────────────────────────────────────────

// Legado: InsuranceLine se mantiene para compat con módulos previos
// (propuestas v1, pólizas v1, car-quotes). El flujo nuevo usa BranchType.
model InsuranceLine {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  category       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// Compañía aseguradora a nivel global (maestro administrado por SaaS-admin).
// Los datos "predefinidos" del documento (razón social, RUT, dirección, etc.)
// viven aquí y los corredores los ven en read-only.
model GlobalInsuranceCompany {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  rut       String?
  address   String?
  commune   String?
  city      String?
  url       String?
  logoUrl   String?
  isLife    Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantProfiles InsuranceCompany[]
  products       GlobalInsuranceProduct[]

  @@unique([name])
}

// Compañía aseguradora a nivel tenant.
// - Si `globalCompanyId` está seteado, los campos heredados se toman del global
//   y aquí solo viven los datos operativos del corredor (código corredor,
//   link cobranza, transferencias, contactos, email default de envío).
// - Si `globalCompanyId` es null, la compañía es "custom" del tenant: todos
//   los campos del global se replican localmente (name, rut, address, etc.).
model InsuranceCompany {
  id              String   @id @default(cuid())
  organizationId  String
  globalCompanyId String?
  // Operativos del corredor:
  brokerCode      String?
  paymentLink     String?
  bankAccountClp  String?
  bankAccountUsd  String?
  defaultEmail    String?
  // Campos "custom" (cuando globalCompanyId es null):
  name            String
  legalName       String?
  rut             String?
  address         String?
  commune         String?
  city            String?
  url             String?
  logoUrl         String?
  isLife          Boolean  @default(false)
  contactEmail    String?
  status          String   @default("ACTIVA")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  globalCompany GlobalInsuranceCompany?   @relation(fields: [globalCompanyId], references: [id])
  contacts      InsuranceCompanyContact[]
  products      InsuranceProduct[]

  @@unique([organizationId, globalCompanyId])
  @@index([organizationId])
}

model InsuranceCompanyContact {
  id                     String   @id @default(cuid())
  organizationId         String
  insuranceCompanyId     String
  name                   String
  lastName               String?
  email                  String?
  phone                  String?
  celular                String?
  role                   String? // cargo
  isDefault              Boolean  @default(false)
  isReservationRecipient Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  insuranceCompany InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([insuranceCompanyId])
}

// Ramo (BranchType): global, administrado por SaaS-admin.
model BranchType {
  id        String   @id @default(cuid())
  key       String   @unique // ej: "incendio", "vehiculos", "casco_maritimo"
  name      String // ej: "Incendio"
  category  String // "GENERALES" | "VIDA_SALUD"
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fieldSchemas   BranchFieldSchema[]
  globalProducts GlobalInsuranceProduct[]
  products       InsuranceProduct[]
  items          ProposalItem[]
  proposals      Proposal[]
  claims         Claim[]
}

// Definición declarativa de los campos de la "ficha de datos" por ramo.
// Se renderiza dinámicamente en el formulario de ítem de propuesta.
model BranchFieldSchema {
  id           String   @id @default(cuid())
  branchTypeId String
  fieldKey     String // ej: "patente", "anio", "tipo_inmueble"
  label        String // ej: "Patente"
  type         String // "text" | "number" | "date" | "select" | "textarea"
  required     Boolean  @default(false)
  order        Int      @default(0)
  options      Json? // [{value,label}] cuando type=select
  helpText     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branchType BranchType @relation(fields: [branchTypeId], references: [id], onDelete: Cascade)

  @@unique([branchTypeId, fieldKey])
  @@index([branchTypeId])
}

// Producto a nivel global (maestro).
model GlobalInsuranceProduct {
  id                  String   @id @default(cuid())
  globalCompanyId     String
  branchTypeId        String
  name                String
  code                String?
  commissionAffectPct Decimal? @db.Decimal(6, 3)
  commissionExemptPct Decimal? @db.Decimal(6, 3)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  globalCompany  GlobalInsuranceCompany  @relation(fields: [globalCompanyId], references: [id], onDelete: Cascade)
  branchType     BranchType              @relation(fields: [branchTypeId], references: [id])
  coverages      GlobalProductCoverage[]
  tenantProducts InsuranceProduct[]

  @@unique([globalCompanyId, name])
  @@index([branchTypeId])
}

model GlobalProductCoverage {
  id                String   @id @default(cuid())
  globalProductId   String
  order             Int      @default(0)
  name              String // nombre cobertura
  polCad            String? // "POL"/"CAD"
  text              String? // texto cobertura
  insuredAmount     Decimal? @db.Decimal(16, 2)
  type              String // "COBERTURA" | "ADICIONAL"
  isCommercialValue Boolean  @default(false)
  affectedByIva     Boolean  @default(false)
  sumsToTotal       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product GlobalInsuranceProduct @relation(fields: [globalProductId], references: [id], onDelete: Cascade)

  @@index([globalProductId])
}

// Producto a nivel tenant (override o custom).
// - Si globalProductId != null: hereda del global, puede sobreescribir % comisión
//   y agregar coberturas propias.
// - Si globalProductId == null: es un producto 100% custom del tenant.
model InsuranceProduct {
  id                  String   @id @default(cuid())
  organizationId      String
  globalProductId     String?
  insuranceCompanyId  String
  branchTypeId        String?
  name                String
  code                String?
  commissionAffectPct Decimal? @db.Decimal(6, 3)
  commissionExemptPct Decimal? @db.Decimal(6, 3)
  // Garantías por obra, transporte por viaje, etc. no entran a la cola.
  isRenewable         Boolean  @default(true)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  globalProduct    GlobalInsuranceProduct? @relation(fields: [globalProductId], references: [id])
  insuranceCompany InsuranceCompany        @relation(fields: [insuranceCompanyId], references: [id], onDelete: Cascade)
  branchType       BranchType?             @relation(fields: [branchTypeId], references: [id])
  coverages        TenantProductCoverage[]

  @@unique([organizationId, insuranceCompanyId, globalProductId])
  @@index([organizationId])
  @@index([insuranceCompanyId])
}

model TenantProductCoverage {
  id                String   @id @default(cuid())
  organizationId    String
  productId         String
  order             Int      @default(0)
  name              String
  factor            Decimal? @db.Decimal(10, 4)
  polCad            String?
  text              String?
  insuredAmount     Decimal? @db.Decimal(16, 2)
  premium           Decimal? @db.Decimal(14, 2)
  type              String // "COBERTURA" | "ADICIONAL"
  isCommercialValue Boolean  @default(false)
  affectedByIva     Boolean  @default(false)
  sumsToTotal       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product InsuranceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// Clientes
// ─────────────────────────────────────────────────────────────

enum ClientType {
  PERSONA
  EMPRESA
}

enum ClientStatus {
  PROSPECTO
  ACTIVO
  INACTIVO
}

enum ContactAssignment {
  COBRANZA
  SINIESTROS
  EMISION
}

model Client {
  id               String       @id @default(cuid())
  organizationId   String
  type             ClientType   @default(PERSONA)
  rut              String
  name             String
  firstName        String?
  lastNamePaterno  String?
  lastNameMaterno  String?
  legalName        String?
  nombreFantasia   String?
  esExtranjero     Boolean      @default(false)
  externalId       String?
  email            String?
  phone            String?
  celular          String?
  birthDate        DateTime?    @db.Date
  address          String?
  region           String?
  commune          String?
  city             String?
  assignedUserId   String?
  source           String?
  status           ClientStatus @default(PROSPECTO)
  observaciones    String?
  createdById      String?
  updatedById      String?
  giro             String?
  comentarioAlerta String?
  // Consentimiento explícito (Ley 21.719): marketing y procesamiento con IA.
  marketingConsent       Boolean   @default(false)
  marketingConsentAt     DateTime?
  aiProcessingConsent    Boolean   @default(false)
  aiProcessingConsentAt  DateTime?
  vendedor         String?
  cobranzaUserId   String?
  siniestrosUserId String?
  holdingId        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  contacts       ClientContact[]
  relationships  ClientRelationship[]
  tagAssignments ClientTagAssignment[]
  proposals      Proposal[]
  policies       Policy[]
  claims         Claim[]
  branches       Branch[]
  carQuotations  CarQuotation[]
  quoteRequests  QuoteRequest[]
  holding        Holding?              @relation(fields: [holdingId], references: [id])

  @@unique([organizationId, rut])
  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([organizationId, assignedUserId])
}

model ClientContact {
  id             String             @id @default(cuid())
  organizationId String
  clientId       String
  name           String
  role           String?
  email          String?
  phone          String?
  celular        String?
  notes          String?
  externalId     String?
  assignmentType ContactAssignment?
  isPrimary      Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([clientId])
}

model ClientRelationship {
  id               String   @id @default(cuid())
  organizationId   String
  clientId         String
  relatedClientId  String
  relationshipType String
  notes            String?
  createdAt        DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clientId])
}

model ClientTag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("slate")
  createdAt      DateTime @default(now())

  assignments ClientTagAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ClientTagAssignment {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  tagId          String
  createdAt      DateTime @default(now())

  client Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    ClientTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([clientId, tagId])
  @@index([organizationId])
}

model Holding {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clients Client[]

  @@index([organizationId])
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  name           String
  address        String?
  contactName    String?
  commune        String?
  region         String?
  phone          String?
  celular        String?
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────
// Propuestas (modeladas; UI llega en sub-proyecto posterior)
// ─────────────────────────────────────────────────────────────

// Tipo de propuesta: de póliza (nueva/renovación) o de endoso sobre una póliza
// existente. Ambas recorren el mismo flujo (elaboración → envío a la cía →
// recepción → despacho al cliente).
enum ProposalKind {
  POLIZA
  ENDOSO
}

enum ProposalStatus {
  ELABORACION
  POR_ENVIAR
  ENVIADA_COMPANIA
  DEVUELTA
  POR_DESPACHAR
  RECHAZADA
  DESCARTADA
}

model Proposal {
  id                         String           @id @default(cuid())
  organizationId             String
  clientId                   String
  proposalNumber             String
  kind                       ProposalKind     @default(POLIZA)
  // Propuesta de endoso (kind = ENDOSO): póliza endosada, tipo de endoso y
  // detalle del endoso que va en el PDF "Solicitud de Endoso". Al despacharla
  // se crea el Endorsement vinculado (Endorsement.proposalId).
  endorsedPolicyId           String?
  endorsementType            EndorsementType?
  endorsementDetail          String?
  // Delta de prima del endoso (puede ser negativo). La cancelación y la
  // anulación no lo usan: su crédito se calcula al registrar la emisión.
  endorsementPremiumAffected Decimal?         @db.Decimal(18, 4)
  endorsementPremiumExempt   Decimal?         @db.Decimal(18, 4)
  companyId                  String?
  lineId                     String?
  branchId                   String?
  branchTypeId               String?
  productId                  String?
  status                     ProposalStatus   @default(ELABORACION)
  premiumNet                 Decimal?         @db.Decimal(14, 2)
  premiumGross               Decimal?         @db.Decimal(14, 2)
  currency                   String           @default("UF")
  startDate                  DateTime?        @db.Date
  endDate                    DateTime?        @db.Date
  // Hora de vigencia (formato "HH:mm"). La fecha vive en startDate/endDate
  // (día puro) y la hora aquí, para que el PDF muestre fecha + hora sin migrar
  // las columnas Date a DateTime (evita choque de tipos con Policy).
  startTime                  String?
  endTime                    String?
  // Campos del documento "Propuestas":
  sentAt                     DateTime?
  recipientEmail             String?
  recipientContactId         String?
  // Datos de contacto del contratante a nivel propuesta. Por defecto se
  // precargan desde la ficha del Client, pero el corredor puede editarlos
  // (p.ej. poner los datos de la corredora como contacto frente a la cía).
  // El PDF de la propuesta usa ESTOS datos, no los de la ficha del cliente.
  contratanteEmail           String?
  contratantePhone           String?
  contratanteCelular         String?
  quotationId                String?
  quotationNumberRef         String?
  previousPolicyId           String?
  // Asegurado / beneficiario por defecto (la propuesta usa Client.id como
  // contratante; estos son los defaults a nivel propuesta).
  insuredClientId            String?
  beneficiaryClientId        String?
  // Casillas de relación con otras compañías / corredores:
  coaseguro                  Boolean          @default(false)
  coaseguroDetails           Json?
  coCorredor                 Boolean          @default(false)
  coCorredorDetails          Json?
  reaseguro                  Boolean          @default(false)
  reaseguroDetails           Json?
  deOtroCorredor             Boolean          @default(false)
  garantiaSuscripcion        Boolean          @default(false)
  conReserva                 Boolean          @default(false)
  conClausulaInalterabilidad Boolean          @default(false)
  discardedAt                DateTime?
  discardedReason            String?
  facultativo                Boolean          @default(false)
  // Comisión a nivel propuesta (overridea producto):
  commissionAffectPct        Decimal?         @db.Decimal(6, 3)
  commissionExemptPct        Decimal?         @db.Decimal(6, 3)
  observations               String?
  assignedUserId             String?
  salespersonId              String?
  // Renovación
  isRenewal                  Boolean          @default(false)
  previousPolicyNumberText   String?
  // Garantía de suscripción
  garantiaExpiry             DateTime?        @db.Date
  garantiaCompleted          Boolean          @default(false)
  garantiaCompletedAt        DateTime?        @db.Date
  garantiaObservations       String?
  // PDF generado y almacenado al pasar a POR_ENVIAR. Se borra al reabrir.
  pdfBytes                   Bytes?
  pdfGeneratedAt             DateTime?
  // Recepción de la póliza emitida por la compañía (flujo post-envío). En una
  // propuesta de endoso guarda el N° de endoso emitido por la compañía.
  policyNumberGenerated      String?
  policyEmissionDate         DateTime?        @db.Date
  policyReceptionDate        DateTime?        @db.Date
  emissionErrorReason        String? // motivo de error de emisión (devuelta a la compañía)
  emissionErrorDetail        String?
  // Despacho al contratante. En una propuesta de endoso marca el fin del flujo
  // (el endoso ya quedó registrado en la póliza al recepcionarlo).
  dispatchedAt               DateTime?
  currentStateStartedAt      DateTime         @default(now())
  createdById                String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  client                  Client                           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  branchType              BranchType?                      @relation(fields: [branchTypeId], references: [id])
  statusHistory           ProposalStatusHistory[]
  items                   ProposalItem[]
  paymentPlan             PaymentPlan?
  logs                    ProposalLog[]
  brokerParticipations    ProposalBrokerParticipation[]
  coaseguroParticipations ProposalCoaseguroParticipation[]
  policies                Policy[]
  endorsement             Endorsement?
  submissions             PolicySubmission[]
  aiComparisons           AiComparison[]
  dispatches              Dispatch[]
  sourceQuote             QuoteRequest?

  @@unique([organizationId, proposalNumber])
  @@index([organizationId])
  @@index([clientId])
  @@index([endorsedPolicyId])
  @@index([previousPolicyId])
  @@index([quotationId])
}

// Ítem de una propuesta. La ficha de datos depende del ramo (BranchType) y
// se guarda en el JSON `data` validado contra BranchFieldSchema.
model ProposalItem {
  id                  String   @id @default(cuid())
  organizationId      String
  proposalId          String
  branchTypeId        String
  order               Int      @default(0)
  insuredClientId     String?
  beneficiaryClientId String?
  identification      String?
  glossNote           String?
  data                Json     @default("{}")
  // Versión del schema con que se guardó `data`. Permite migrar JSON al leer
  // cuando el SaaS-admin cambia BranchFieldSchema. Ver src/lib/item-data-migration.ts
  dataSchemaVersion   Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  proposal   Proposal               @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  branchType BranchType             @relation(fields: [branchTypeId], references: [id])
  coverages  ProposalItemCoverage[]
  claims     Claim[]

  @@index([organizationId])
  @@index([proposalId])
}

model ProposalItemCoverage {
  id                  String   @id @default(cuid())
  organizationId      String
  itemId              String
  order               Int      @default(0)
  name                String // texto cobertura
  polCad              String? // POL / CAD
  type                String // "COBERTURA" | "ADICIONAL"
  isCommercialValue   Boolean  @default(false)
  insuredAmount       Decimal? @db.Decimal(16, 2)
  insuredCurrency     String   @default("UF")
  affectedByIva       Boolean  @default(false)
  taxRateAffect       Decimal? @db.Decimal(7, 4) // tasa afecta
  taxRateExempt       Decimal? @db.Decimal(7, 4) // tasa exenta
  premiumAffect       Decimal? @db.Decimal(14, 2)
  premiumExempt       Decimal? @db.Decimal(14, 2)
  premiumNet          Decimal? @db.Decimal(14, 2) // total prima neta
  ivaAmount           Decimal? @db.Decimal(14, 2)
  premiumGross        Decimal? @db.Decimal(14, 2) // prima bruta
  commissionAffectPct Decimal? @db.Decimal(6, 3)
  commissionExemptPct Decimal? @db.Decimal(6, 3)
  commissionAmount    Decimal? @db.Decimal(14, 2)
  sumsToTotal         Boolean  @default(true)
  deductibleText      String?
  deductibleAmount    Decimal? @db.Decimal(18, 4)
  deductiblePct       Decimal? @db.Decimal(8, 4)
  deductibleMinimum   Decimal? @db.Decimal(18, 4)
  manualPremium       Boolean  @default(false) // "cálculo manual de primas"
  autoLoaded          Boolean  @default(false) // cargada automáticamente desde TenantProductCoverage
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  item ProposalItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([itemId])
}

enum PaymentOption {
