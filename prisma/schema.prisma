  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  broker   Broker   @relation(fields: [brokerId], references: [id])

  @@index([organizationId])
  @@index([proposalId])
  @@index([brokerId])
}

model ProposalCoaseguroParticipation {
  id                 String   @id @default(cuid())
  organizationId     String
  proposalId         String
  insuranceCompanyId String
  participationPct   Decimal  @db.Decimal(6, 3)
  policyNumber       String?
  createdAt          DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([proposalId])
}

// ─────────────────────────────────────────────────────────────
// Pólizas (modeladas; UI llega en sub-proyecto posterior)
// ─────────────────────────────────────────────────────────────

enum PolicyStatus {
  VIGENTE
  VENCIDA
  RENOVADA
  CANCELADA
  ANULADA
}

model Policy {
  id                     String       @id @default(cuid())
  organizationId         String
  clientId               String
  proposalId             String?
  policyNumber           String
  companyId              String?
  lineId                 String?
  branchId               String?
  status                 PolicyStatus @default(VIGENTE)
  premiumNet             Decimal?     @db.Decimal(14, 2) // total = afecta + exenta
  // Desglose de prima neta: afecta (gravada con IVA) vs exenta. premiumNet es la suma.
  premiumAffect          Decimal?     @db.Decimal(14, 2)
  premiumExempt          Decimal?     @db.Decimal(14, 2)
  currency               String       @default("UF")
  commissionPercent      Decimal?     @db.Decimal(9, 4)
  commissionAmount       Decimal?     @db.Decimal(14, 2)
  // Desglose de comisión: monto calculado, afecta/exenta (montos y %),
  // comisión final de la compañía y flag de pagada.
  commissionCalculated   Decimal?     @db.Decimal(14, 4)
  commissionAffect       Decimal?     @db.Decimal(14, 4)
  commissionExempt       Decimal?     @db.Decimal(14, 4)
  commissionAffectPct    Decimal?     @db.Decimal(6, 3)
  commissionExemptPct    Decimal?     @db.Decimal(6, 3)
  commissionFinalCompany Decimal?     @db.Decimal(14, 2)
  // Estado de la comisión decidido en la revisión de comisiones: true = se
  // dejó pagada por la compañía (aunque haya una diferencia menor), false = se
  // dejó pendiente (p.ej. pago parcial a reclamar), null = automático según la
  // suma de pagos registrados.
  commissionPaid         Boolean?
  // Snapshot del tipo de cambio al momento de la póliza: valor en pesos de la
  // moneda de la póliza (Cambio) y de la UF. Permite re-expresar montos históricos.
  exchangeRate           Decimal?     @db.Decimal(14, 4)
  ufValue                Decimal?     @db.Decimal(14, 4)
  startDate              DateTime?    @db.Date
  endDate                DateTime?    @db.Date
  previousPolicyId       String?
  nextPolicyId           String?
  externalId             String?
  // Producto contratado. En pólizas emitidas en Polizza se hereda de la
  // propuesta; en las importadas lo setea el import desde el catálogo legacy.
  productId              String?
  assignedUserId         String?
  // Vendedor (ejecutivo comercial) asociado a la póliza para liquidar su
  // comisión. Precargado desde Proposal.salespersonId al convertir, editable.
  salespersonId          String?
  // Override de la tasa de comisión del vendedor PARA ESTA PÓLIZA. null = usa
  // la tasa default configurada del vendedor (SalespersonCommissionRate). El
  // admin la baja aquí cuando se negocia un acuerdo para cerrar un deal.
  salesCommissionPct     Decimal?     @db.Decimal(6, 3)
  // No renovable por naturaleza (garantía de obra, viaje, etc.).
  notRenewable           Boolean      @default(false)
  // No renovación registrada, reversible. null = no hay decisión.
  nonRenewalReason       String?
  nonRenewalNote         String?
  nonRenewalAt           DateTime?
  // Saldo único tras cancelar o anular. Positivo: el cliente debe.
  // Negativo: devolución. Estimado hasta el monto de la compañía.
  terminationBalance           Decimal? @db.Decimal(18, 4)
  terminationBalanceIsEstimate Boolean  @default(false)
  terminationReason            String?
  // La póliza se emite aunque el documento venga con diferencias.
  // Vacío = emisión correcta.
  issueProblemCode     String?
  issueProblemDetail   String?
  issueProblemOpenedAt DateTime?
  version                Int          @default(0)
  reopenedIssueAt        DateTime?
  reopenedIssueReason    String?
  createdById            String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  client                    Client                          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposal                  Proposal?                       @relation(fields: [proposalId], references: [id])
  items                     PolicyItem[]
  coverages                 PolicyCoverage[]
  statusHistory             PolicyStatusHistory[]
  installments              Installment[]
  endorsements              Endorsement[]
  premiumMovements          PremiumMovement[]
  commissionReceivables     CommissionReceivable[]
  aiComparisons             AiComparison[]
  dispatches                Dispatch[]
  companyCommissionPayments CompanyCommissionPayment[]
  sellerCommissionItem      SellerCommissionSettlementItem?

  @@unique([organizationId, policyNumber])
  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([clientId])
  @@index([productId])
  @@index([organizationId, salespersonId])
}

model PolicyItem {
  id             String   @id @default(cuid())
  organizationId String
  policyId       String
  description    String
  insuredAmount  Decimal? @db.Decimal(16, 2)
  currency       String   @default("UF")
  createdAt      DateTime @default(now())

  policy Policy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  claims Claim[]

  @@index([organizationId])
  @@index([policyId])
}

model PolicyCoverage {
  id             String   @id @default(cuid())
  organizationId String
  policyId       String
  name           String
  deductible     String?
  deductibleAmount  Decimal? @db.Decimal(18, 4)
  deductiblePct     Decimal? @db.Decimal(8, 4)
  deductibleMinimum Decimal? @db.Decimal(18, 4)
  insuredAmount  Decimal? @db.Decimal(16, 2)
  currency       String   @default("UF")
  createdAt      DateTime @default(now())

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([policyId])
}

model PolicyStatusHistory {
  id             String       @id @default(cuid())
  organizationId String
  policyId       String
  status         PolicyStatus
  note           String?
  changedById    String?
  createdAt      DateTime     @default(now())

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([policyId])
}

// ─────────────────────────────────────────────────────────────
// Comisiones: pagos de compañía a la corredora y liquidación a vendedores
// ─────────────────────────────────────────────────────────────

// Tasa default de comisión que gana un vendedor, como % de la comisión que
// cobra la corredora. La edita el admin. Override por póliza en
// Policy.salesCommissionPct.
model SalespersonCommissionRate {
  id             String   @id @default(cuid())
  organizationId String
  userId         String // miembro/usuario vendedor
  defaultPct     Decimal  @db.Decimal(6, 3)
  isActive       Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
}

// Pago recibido de la compañía por la comisión de una póliza. Permite pagos
// parciales / varias facturas por póliza. La póliza se considera "pagada por la
// compañía" cuando la suma de pagos cubre Policy.commissionAmount.
model CompanyCommissionPayment {
  id             String    @id @default(cuid())
  organizationId String
  policyId       String
  paymentDate    DateTime  @db.Date
  amount         Decimal   @db.Decimal(14, 2)
  currency       String    @default("CLP")
  invoiceNumber  String?
  invoiceDate    DateTime? @db.Date
  // Factor de conversión a CLP usado al registrar (UF→$, USD→$, etc.).
  exchangeFactor Decimal?  @db.Decimal(14, 4)
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([policyId])
}

enum SellerSettlementStatus {
  PENDIENTE
  PAGADA
}

// Liquidación de comisiones a un vendedor: agrupa las pólizas pagadas por la
// compañía y aún no liquidadas, calculando el pago al vendedor.
model SellerCommissionSettlement {
  id             String                 @id @default(cuid())
  organizationId String
  salespersonId  String
  number         Int // correlativo por organización
  status         SellerSettlementStatus @default(PENDIENTE)
  // Moneda de la liquidación. Una liquidación agrupa solo pólizas de una misma
  // moneda (la comisión del vendedor se calcula en la moneda de la póliza).
  currency       String                 @default("CLP")
  totalAmount    Decimal                @db.Decimal(14, 2)
  notes          String?
  paidAt         DateTime?
  createdById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  items SellerCommissionSettlementItem[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([organizationId, salespersonId])
}

// Detalle de una liquidación: una póliza, su comisión corredora base, la tasa
// aplicada y el pago resultante al vendedor. policyId único por org: una póliza
// solo puede liquidarse una vez.
model SellerCommissionSettlementItem {
  id                   String   @id @default(cuid())
  organizationId       String
  settlementId         String
  policyId             String   @unique
  baseCommissionAmount Decimal  @db.Decimal(14, 2)
  appliedPct           Decimal  @db.Decimal(6, 3)
  amount               Decimal  @db.Decimal(14, 2)
  currency             String   @default("CLP")
  createdAt            DateTime @default(now())

  settlement SellerCommissionSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  policy     Policy                     @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([settlementId])
}

// ─────────────────────────────────────────────────────────────
// Workflow transversal: tareas, alertas, comentarios, bitácora
// ─────────────────────────────────────────────────────────────

enum EntityType {
  CLIENT
  PROPOSAL
  POLICY
  CLAIM
  RENEWAL
  TASK
  CAR_QUOTATION
}

enum TaskStatus {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
  CANCELADA
}

enum TaskPriority {
  BAJA
  MEDIA
  ALTA
}

enum AlertSeverity {
  INFO
  ADVERTENCIA
  CRITICA
}

enum AlertStatus {
  ABIERTA
  RESUELTA
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String?
  entityType     EntityType?
  entityId       String?
  assignedUserId String?
  dueDate        DateTime?
  priority       TaskPriority @default(MEDIA)
  status         TaskStatus   @default(PENDIENTE)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, assignedUserId])
  @@index([entityType, entityId])
